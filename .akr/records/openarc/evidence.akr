project openarc

record openarc.evidence.best-balanced-15-input-stress-20260821/1 : evidence {
    title "Production Best completes 15-input RAW/JPEG stress run"
    state verified
    result pass
    method command
    observed_at git:efcaac679cb7719e54a9696c4f970bf601154822
    command "/usr/bin/time -v ./target/release/openarc batch-jxl /mnt/Samsung980_1TB/Rust-projects/raw-autotune/raw/raw_at_night -o <temporary-directory> --effort best --bpp 3"
    summary """
        The corrected production Best path completed all 15 input encodes in 1:40.35 with 3,174,392 KiB maximum RSS and exit status 0; paired ARW/JPG stem collisions left 8 distinct output paths and were logged separately.
        """
}

record openarc.evidence.best-balanced-raw-rate-20260821/1 : evidence {
    title "OpenArc Best reaches the Balanced target band"
    state verified
    result pass
    method command
    observed_at git:efcaac679cb7719e54a9696c4f970bf601154822
    command "./target/release/openarc convert-jxl /mnt/Samsung980_1TB/Rust-projects/raw-autotune/raw/raw_at_night/_DSC1312.ARW --output .agent/scratch/jpxl-rate-diagnosis/_DSC1312-best-production-3bpp.jxl --effort best --bpp 3.0"
    summary """
        The 6000x4000 RAW encoded to 8,930,777 bytes against a 9,000,000-byte target (0.77% under, inside Balanced's 2% band) in 12.13 s with 2,701,988 KiB peak RSS.
        """
}

record openarc.evidence.bounded-raw-jxl-corpus-20260821/1 : evidence {
    title "Bounded full-corpus RAW/JXL release run"
    state verified
    result pass
    method command
    observed_at git:efcaac679cb7719e54a9696c4f970bf601154822
    command "/usr/bin/time -v ./target/release/openarc create /mnt/Samsung980_1TB/Rust-projects/raw-autotune/raw/raw_at_night --output .agent/scratch/fixed-full-output --no-zip --jxl-effort best --jxl-bpp 3.0 --no-catalog --no-dedup --no-tracking"
    summary """
        The fixed release build processed all 15 inputs with zero failures in 205.81 s at 6,149,260 KiB peak RSS, producing 134 MB from 490 MB.
        """
