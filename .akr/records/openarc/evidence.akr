record openarc.evidence.raw-jxl-component-profile-20260821/1 : evidence {
    title "RAW and JPEG XL component release profile"
    state verified
    result pass
    method observation
    observed_at git:efcaac679cb7719e54a9696c4f970bf601154822
    summary """
        On _DSC1312.ARW, raw-autotune alone took 6.06 s at 1,475,452 KiB RSS; the full best/3.0 bpp path took 18.79 s at 2,745,088 KiB, and three serialized full encodes took 54.57 s at 3,129,360 KiB.
        """
}

record openarc.evidence.raw-jxl-oom-kernel-20260821/1 : evidence {
    title "Kernel OOM diagnosis for RAW/JXL batch"
    state verified
    result pass
    method command
    observed_at git:efcaac679cb7719e54a9696c4f970bf601154822
    command "journalctl -k -b --no-pager -g 'oom|Out of memory|Killed process'"
    summary """
        Kernel logged openarc killed at anon-rss 18,755,672 KiB (total-vm 28,394,096 KiB) on the 31 GiB no-swap host.
        """
}

record openarc.evidence.raw-jxl-throughput-comparison-20260821/1 : evidence {
    title "RAW/JXL admission throughput comparison"
    state verified
    result pass
    method observation
    observed_at git:efcaac679cb7719e54a9696c4f970bf601154822
    summary """
        The failed over-admitted run completed 5 files in about 95 s before OOM (~19.0 s/file); the bounded two-image run completed all 15 in 205.81 s (~13.7 s/file), while a serialized three-file baseline was 18.2 s/file.
        """
}

record openarc.evidence.uniform-fixed-bpp-inventory-20260821/1 : evidence {
    title "Existing outputs match the 1.50 bpp ceiling"
    state verified
    result pass
    method observation
    observed_at git:efcaac679cb7719e54a9696c4f970bf601154822
    summary """
        All 15 current 6000x4000 JXLs were 4,432,403–4,485,279 bytes, or 1.477–1.495 bpp (98.5–99.7% of the 4,500,000-byte Fast target), proving the uniform sizes are the fixed-rate contract rather than a shared memory buffer cap.
        """
}

record openarc.evidence.workspace-test-gate-missing-arcmax-bins-20260821/1 : evidence {
