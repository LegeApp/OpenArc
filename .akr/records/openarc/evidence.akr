record openarc.evidence.bounded-raw-jxl-output-integrity-20260821/1 : evidence {
    title "Bounded RAW/JXL output integrity"
    state verified
    result pass
    method command
    observed_at git:efcaac679cb7719e54a9696c4f970bf601154822
    command "sha256sum --check HASHES.sha256"
    summary """
        All 15 emitted JXL files plus MANIFEST.txt and OPENARC_INDEX.json matched the generated hash list; the fixed batch _DSC1312 stream was byte-identical to the single-file baseline.
        """
}

