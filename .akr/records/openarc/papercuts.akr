record openarc.papercut.while-constructing-a-small-batch-benchmark/1 : papercut {
    title "While constructing a small batch benchmark, `batch-jxl` silently…"
    state verified
    statement """
        While constructing a small batch benchmark, `batch-jxl` silently reported “Encoded 0 image(s)” for a directory containing symlinked supported RAW files. `find_images` neither follows nor reports skipped symlinks, which makes test/real input discovery misleading.
        """
    observed_at git:efcaac679cb7719e54a9696c4f970bf601154822
    author "codex"
    created_at 2026-08-21
}

