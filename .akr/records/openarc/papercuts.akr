record openarc.papercut.the-required-cargo-test-release-workspace-gate/1 : papercut {
    title "The required `cargo test --release --workspace` gate cannot start…"
    state verified
    statement """
        The required `cargo test --release --workspace` gate cannot start because vendored `arcmax` declares five bin targets whose source files are absent (`compression-bench`, `dispack-file`, `profile-all`, `profile-ppmd-h`, `raw_analyze`). Targeted OpenArc/codecs release tests are the usable fallback.
        """
    observed_at git:efcaac679cb7719e54a9696c4f970bf601154822
    author "codex"
    created_at 2026-08-21
}

