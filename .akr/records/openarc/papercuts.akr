project openarc

record openarc.papercut.a-15-input-batch-jxl-stress-run-over-paired-arw/1 : papercut {
    title "A 15-input `batch-jxl` stress run over paired ARW/JPG files reported 15…"
    state verified
    statement """
        A 15-input `batch-jxl` stress run over paired ARW/JPG files reported 15 encodes but left only 8 outputs because both extensions map to the same `.jxl` stem. The standalone batch command should reject/disambiguate collisions or apply the archive pipeline's paired-JPEG policy.
        """
    observed_at git:efcaac679cb7719e54a9696c4f970bf601154822
    author "codex"
    created_at 2026-08-21
}

record openarc.papercut.a-focused-rust-unit-test-invocation-with-a-bare/1 : papercut {
    title "A focused Rust unit-test invocation with a bare name plus --exact…"
    state verified
    statement """
        A focused Rust unit-test invocation with a bare name plus --exact compiled but ran zero tests because the harness name included its module prefix; use a substring filter or the fully qualified name.
        """
