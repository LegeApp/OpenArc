record openarc.papercut.a-multi-hunk-patch-against-one-file-was/1 : papercut {
    title "A multi-hunk patch against one file was rejected because separate…"
    state verified
    statement """
        A multi-hunk patch against one file was rejected because separate `Update File` sections targeted the same path. The patch format requires all hunks for a file under one update block, but the error only appears at application time.
        """
    observed_at git:efcaac679cb7719e54a9696c4f970bf601154822
    about "apply_patch"
    author "codex"
    created_at 2026-08-21
}

record openarc.papercut.cargo-fmt-all-check-and-git-diff-check-cannot/1 : papercut {
    title "`cargo fmt --all -- --check` and `git diff --check` cannot isolate this…"
    state verified
    statement """
        `cargo fmt --all -- --check` and `git diff --check` cannot isolate this scheduler change: the in-progress JPEG XL migration already contains many unformatted files, and `src/orchestrator.rs` has CRLF lines that Git reports wholesale as trailing whitespace. Focused compile/tests are needed until that migration is normalized.
        """
    observed_at git:efcaac679cb7719e54a9696c4f970bf601154822
    author "codex"
    created_at 2026-08-21
}

record openarc.papercut.cargo-fmt-all-check-is-already-red-across-the/1 : papercut {
    title "cargo fmt --all -- --check is already red across the uncommitted JPEG…"
    state verified
    statement """
        cargo fmt --all -- --check is already red across the uncommitted JPEG XL migration, including large unrelated files; avoid bulk formatting and verify touched-file formatting selectively.
        """
    observed_at git:efcaac679cb7719e54a9696c4f970bf601154822
    author "codex"
    created_at 2026-08-21
}

